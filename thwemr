        ['Crimson'] = {
            Background = Color3.fromRGB(30, 15, 20),
            Foreground = Color3.fromRGB(40, 22, 28),
            ForegroundLight = Color3.fromRGB(50, 30, 35),
            Border = Color3.fromRGB(65, 40, 50),
