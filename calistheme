        },
        ['OceanBlue'] = {
            Background = Color3.fromRGB(15, 25, 35),
            Foreground = Color3.fromRGB(22, 35, 45),
            ForegroundLight = Color3.fromRGB(30, 45, 55),
            Border = Color3.fromRGB(40, 60, 75),
