            AccentLight = Color3.fromRGB(80, 220, 255),
            AccentDark = Color3.fromRGB(0, 130, 180),
            Text = Color3.fromRGB(255, 255, 255),
        },
        ['Crimson'] = {
            Background = Color3.fromRGB(30, 15, 20),
            Foreground = Color3.fromRGB(40, 22, 28),
            ForegroundLight = Color3.fromRGB(50, 30, 35),
            Border = Color3.fromRGB(65, 40, 50),
            Accent = Color3.fromRGB(255, 50, 80),
            AccentLight = Color3.fromRGB(255, 100, 130),
            AccentDark = Color3.fromRGB(180, 30, 55),
            Text = Color3.fromRGB(255, 255, 255),
        },
        ['Forest'] = {
            Background = Color3.fromRGB(18, 28, 20),
            Foreground = Color3.fromRGB(25, 38, 28),
            ForegroundLight = Color3.fromRGB(32, 48, 35),
            Border = Color3.fromRGB(40, 60, 45),
            Accent = Color3.fromRGB(80, 255, 120),
            AccentLight = Color3.fromRGB(130, 255, 160),
            AccentDark = Color3.fromRGB(50, 180, 80),
            Text = Color3.fromRGB(255, 255, 255),
        },
        ['Light'] = {
            Background = Color3.fromRGB(245, 245, 245),
            Foreground = Color3.fromRGB(235, 235, 235),
            ForegroundLight = Color3.fromRGB(240, 240, 240),
            Border = Color3.fromRGB(200, 200, 200),
            Accent = Color3.fromRGB(0, 120, 255),
            AccentLight = Color3.fromRGB(77, 163, 255),
            AccentDark = Color3.fromRGB(0, 86, 178),
            Text = Color3.fromRGB(0, 0, 0),
        },
    }

    function ThemeManager:SetLibrary(library)
        self.Library = library
        self:ForceTheme()
    end

    function ThemeManager:ForceTheme()
        if not self.Library then return end
        self:ApplyTheme(self.DefaultTheme)
    end

    -- Folders
    function ThemeManager:GetPaths()
        local paths = {}
        local parts = self.Folder:split('/')
        for idx = 1, #parts do
            paths[#paths + 1] = table.concat(parts, '/', 1, idx)
        end
        paths[#paths + 1] = self.Folder .. '/themes'
        return paths
    end

    function ThemeManager:BuildFolderTree()
        local paths = self:GetPaths()
        for i = 1, #paths do
            local str = paths[i]
            if isfolder(str) then continue end
            makefolder(str)
        end
    end

    function ThemeManager:CheckFolderTree()
        if isfolder(self.Folder) then return end
        self:BuildFolderTree()
        task.wait(0.1)
    end

    function ThemeManager:SetFolder(folder)
        self.Folder = folder
        self:BuildFolderTree()
    end

    -- Apply Theme
    function ThemeManager:ApplyTheme(themeName)
        local customTheme = self:GetCustomTheme(themeName)
        local theme = customTheme or self.BuiltInThemes[themeName]
        if not theme then return end
        self.Library:SetTheme(theme, true)
        if self.Library.Flags then
            self.Library.Flags.ThemeManager_ThemeList = themeName
        end
    end

    -- Get Custom Theme
    function ThemeManager:GetCustomTheme(file)
        local path = self.Folder .. '/themes/' .. file .. '.json'
        if not isfile(path) then return nil end
        local data = readfile(path)
        local success, decoded = pcall(httpService.JSONDecode, httpService, data)
        if not success then return nil end
        return decoded
    end

    -- Save Custom Theme
    function ThemeManager:SaveCustomTheme(file)
        if file:gsub(' ', '') == '' then return end
        local theme = {}
        local fields = {
            "Background", "Foreground", "ForegroundLight", 
            "Border", "Accent", "AccentLight", "AccentDark", "Text"
        }
        for _, field in ipairs(fields) do
            theme[field] = self.Library.Theme[field]:ToHex()
        end
        writefile(self.Folder .. '/themes/' .. file .. '.json', httpService:JSONEncode(theme))
    end

    -- Delete Custom Theme
    function ThemeManager:Delete(name)
        if not name then return false, 'no theme selected' end
        local file = self.Folder .. '/themes/' .. name .. '.json'
        if not isfile(file) then return false, 'invalid file' end
        local success = pcall(delfile, file)
        if not success then return false, 'delete file error' end
        return true
    end

    -- Reload Custom Themes
    function ThemeManager:ReloadCustomThemes()
        local list = listfiles(self.Folder .. '/themes')
        local out = {}
        for i = 1, #list do
            local file = list[i]
            if file:sub(-5) == '.json' then
                local pos = file:find('.json', 1, true)
                local start = pos
                local char = file:sub(pos, pos)
                while char ~= '/' and char ~= '\\' and char ~= '' do
                    pos = pos - 1
                    char = file:sub(pos, pos)
                end
                if char == '/' or char == '\\' then
                    table.insert(out, file:sub(pos + 1, start - 1))
                end
            end
        end
        return out
    end

    -- Save Default Theme
    function ThemeManager:SaveDefault(theme)
        writefile(self.Folder .. '/themes/default.txt', theme)
    end

    -- Load Default Theme
    function ThemeManager:LoadDefault()
        local defaultPath = self.Folder .. '/themes/default.txt'
        if isfile(defaultPath) then
            local name = readfile(defaultPath)
            if name and name ~= "" then
                self:ApplyTheme(name)
                if self.Library.Flags then
                    self.Library.Flags.ThemeManager_ThemeList = name
                end
                return
            end
        end
        self:ApplyTheme(self.DefaultTheme)
        if self.Library.Flags then
            self.Library.Flags.ThemeManager_ThemeList = self.DefaultTheme
        end
    end

    -- Build Theme Manager for RIGHT side
    function ThemeManager:BuildThemeManager(section)
        assert(self.Library, 'Must set ThemeManager.Library first!')
        
        section:AddLabel({ Title = "─── Theme Manager ───" })
        
        -- Theme list dropdown
        local themeNames = {}
        for name in pairs(self.BuiltInThemes) do
            table.insert(themeNames, name)
        end
        table.sort(themeNames)
        
        local themeDropdown = section:AddDropdown({
            Title = "Theme List",
            Values = themeNames,
            Default = self.DefaultTheme,
            Flag = "ThemeManager_ThemeList",
            Callback = function(value)
                self:ApplyTheme(value)
            end
        })
        
        section:AddButton({
            Title = "Set as Default Theme",
            Callback = function()
                local name = self.Library.Flags.ThemeManager_ThemeList
                if name then
                    self:SaveDefault(name)
                end
            end
        })
        
        section:AddLabel({ Title = "──────────────────" })
        
        -- Custom Theme Creator
        section:AddLabel({ Title = "Custom Theme Name" })
        section:AddInput({
            Title = "",
            Placeholder = "Enter theme name...",
            Default = "",
            Flag = "ThemeManager_CustomThemeName",
        })
        
        section:AddButton({
            Title = "Create Custom Theme",
            Callback = function()
                local name = self.Library.Flags.ThemeManager_CustomThemeName or ""
                if name:gsub(' ', '') == '' then
                    return
                end
                self:SaveCustomTheme(name)
                local customThemes = self:ReloadCustomThemes()
                if self.Library.Flags then
                    self.Library.Flags.ThemeManager_CustomThemeList = customThemes
                end
            end
        })
        
        section:AddLabel({ Title = "──────────────────" })
        
        -- Custom Theme List
        local customDropdown = section:AddDropdown({
            Title = "Custom Themes",
            Values = self:ReloadCustomThemes(),
            Flag = "ThemeManager_CustomThemeList",
            Multi = false,
        })
        
        section:AddButton({
            Title = "Load Custom Theme",
            Callback = function()
                local name = self.Library.Flags.ThemeManager_CustomThemeList
                if name then
                    self:ApplyTheme(name)
                end
            end
        })
        
        section:AddButton({
            Title = "Delete Custom Theme",
            Callback = function()
                local name = self.Library.Flags.ThemeManager_CustomThemeList
                if not name then return end
                self:Delete(name)
                self.Library.Flags.ThemeManager_CustomThemeList = nil
                customDropdown:Refresh(self:ReloadCustomThemes())
            end
        })
        
        section:AddButton({
            Title = "Refresh List",
            Callback = function()
                customDropdown:Refresh(self:ReloadCustomThemes())
            end
        })
        
        section:AddLabel({ Title = "──────────────────" })
        
        section:AddButton({
            Title = "Reset to Default Theme",
            Callback = function()
                pcall(delfile, self.Folder .. '/themes/default.txt')
                self:ApplyTheme(self.DefaultTheme)
            end
        })
        
        -- Load default theme on startup
        self:LoadDefault()
    end

    ThemeManager:BuildFolderTree()
end

getgenv().CallistoThemeManager = ThemeManager
return ThemeManager
